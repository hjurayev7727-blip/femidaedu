# ── Supabase (Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# MAXFIY — faqat serverda. Hech qachon NEXT_PUBLIC_ bilan boshlamang va git'ga qo'shmang.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── Sayt manzili (Telegram widget qaytish manzili uchun) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Telegram (@BotFather) ──
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=aplus_huquq_bot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Savollarni yuklash (npm run db:import) — Supabase → Connect → Session pooler ──
DATABASE_URL=postgresql://postgres.xxxxxxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Telegram bot webhook va eslatmalar (npm run bot:setup) ──
# Tasodifiy 32+ belgi: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron (08:00 va 20:00 eslatmalar) — Vercel o'zi Authorization: Bearer <CRON_SECRET> yuboradi
CRON_SECRET=

# ── AI (Claude) — yozma javobni qayta tekshirish, "AI'dan so'rash", savol generatori ──
ANTHROPIC_API_KEY=
